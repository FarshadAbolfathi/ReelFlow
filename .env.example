# ReelFlow configuration. Copy to .env and fill in. NEVER commit .env.
# Generate secrets with:  npm run setup   (writes .env with random secrets)

# ── Core ────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3100
WEB_PORT=3100
API_PORT=4000
API_HOST=127.0.0.1
DATABASE_URL=postgresql://reelflow:reelflow_dev_password@127.0.0.1:5434/reelflow
REDIS_URL=redis://127.0.0.1:6380
STORAGE_PATH=./storage
LOG_LEVEL=info
DEFAULT_TIMEZONE=Asia/Tehran
DEFAULT_LOCALE=fa

# 32+ random bytes, base64. Used to sign sessions.
SESSION_SECRET=
# Exactly 32 random bytes, base64. Encrypts platform tokens at rest (AES-256-GCM).
ENCRYPTION_KEY=

# First owner account (created by `npm run db:seed` if no users exist)
BOOTSTRAP_OWNER_EMAIL=owner@reelflow.local
BOOTSTRAP_OWNER_PASSWORD=

# ── Publishing policy ceilings (operator-only; UI settings can never exceed) ─
# Code clamps these to absolute maxima; see packages/config/src/policy.ts.
POLICY_MAX_POSTS_PER_DAY=10
POLICY_MAX_POSTS_PER_HOUR=2
POLICY_MIN_POST_INTERVAL_MINUTES=60
POLICY_MAX_CONCURRENT_PUBLISH=1
POLICY_MAX_POSTS_PER_SOURCE_PER_DAY=4
# Only OWNER users may approve sources (true is strongly recommended).
POLICY_SOURCES_REQUIRE_OWNER_APPROVAL=true

# ── Uploads ─────────────────────────────────────────────────────────────
UPLOAD_MAX_BYTES=524288000

# ── Network (process-level only; never changes macOS settings) ─────────
# direct | proxy
NETWORK_MODE=direct
PROXY_PROVIDER=vps-proxy
# http | socks5 — sing-box "mixed" inbound supports both on one port
PROXY_SCHEME=http
PROXY_HOST=127.0.0.1
PROXY_PORT=10808
PROXY_HEALTH_URL=https://www.gstatic.com/generate_204
PROXY_HEALTH_TIMEOUT_SECONDS=20
# Reference only — this Flutter app changes the system proxy, so it is never launched.
VPS_PROXY_PROJECT_PATH=/path/to/vpn-app
# The sing-box runtime that actually provides 127.0.0.1:10808
VPS_PROXY_RUNTIME_PATH=/path/to/vpn-connector
VPS_PROXY_BINARY=bin/sing-box
VPS_PROXY_CONFIG=config_proxy.json
# false → only use an already-running proxy (e.g. launchd com.farshad.vpnproxy)
PROXY_MANAGED_START=false

# ── Instagram ──────────────────────────────────────────────────────────
# Accounts are connected in the Accounts page and stored encrypted — not here.
#   mock    nothing is posted (development/tests)
#   live    official Graph API (needs a Meta developer app + user token)
#   session log in to Instagram inside ReelFlow (username/password or browser
#           sessionid). Also lets Instagram pages be used as sources.
INSTAGRAM_GRAPH_API_VERSION=v23.0
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
PUBLISHING_ADAPTER_MODE=mock
# session mode: HTTP transport to Instagram. auto = curl (closest to the app),
# switching to requests if curl cannot connect through your network/proxy.
INSTAGRAM_TRANSPORT=auto

# ── Python ingestion engine ────────────────────────────────────────────
# Extractors yt-dlp may use. Platforms whose terms forbid automated
# downloading (instagram, facebook, tiktok) are blocked in code regardless.
YTDLP_ALLOWED_EXTRACTORS=
INGEST_INBOX_PATH=./storage/inbox
