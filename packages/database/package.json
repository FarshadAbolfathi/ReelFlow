{
  "name": "@reelflow/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": { ".": "./src/index.ts" },
  "scripts": {
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev && prisma generate",
    "migrate:deploy": "prisma migrate deploy && prisma generate",
    "seed": "tsx prisma/seed.ts",
    "studio": "prisma studio",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@reelflow/config": "*",
    "@reelflow/security": "*",
    "@reelflow/types": "*",
    "dotenv": "^17.0.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "prisma": "7.10.0"
  }
}
